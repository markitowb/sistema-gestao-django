# .gitattributes
# Normaliza finais de linha para LF em todos os arquivos de texto
* text=auto eol=lf

# Arquivos que devem ser sempre LF
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Arquivos binários — não mexe
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary 